    "jsonrpc": "2.0",
    "method": "sub",
    "params": {"x": 25, "y": 10},
    "id": 26
}

### 5.2. MUL с именованными параметрами
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "mul",
    "params": {"x": 3.5, "y": 2.5},
    "id": 27
}

### 5.3. DIV с именованными параметрами
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "div",
    "params": {"x": 45.6, "y": 3.2},
    "id": 28
}

### 5.4. FACT с именованным параметром
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": {"x": 4},
    "id": 29
}

### 6. КОМПЛЕКСНЫЕ СЦЕНАРИИ

### 6.1. Последовательность математических операций
POST {{host}}{{jsonrpc}}
Content-Type: application/json

[
    {
        "jsonrpc": "2.0",
        "method": "sum",
        "params": [10, 20],
        "id": 30
    },
    {
        "jsonrpc": "2.0",
        "method": "mul",
        "params": [5, 4],
        "id": 31
    },
    {
        "jsonrpc": "2.0",
        "method": "sub",
        "params": [100, 45],
        "id": 32
    },
    {
        "jsonrpc": "2.0",
        "method": "div",
        "params": [88, 11],
        "id": 33
    }
]

### 6.2. Смешанные успешные и ошибочные операции
POST {{host}}{{jsonrpc}}
Content-Type: application/json

[
    {
        "jsonrpc": "2.0",
        "method": "sum",
        "params": [1, 2],
        "id": 34
    },
    {
        "jsonrpc": "2.0",
        "method": "div",
        "params": [10, 0],
        "id": 35
    },
    {
        "jsonrpc": "2.0",
        "method": "mul",
        "params": [3, 4],
        "id": 36
    },
    {
        "jsonrpc": "2.0",
        "method": "fact",
        "params": [-1],
        "id": 37
    }
]

### 7. ТЕСТЫ ГРАНИЧНЫХ ЗНАЧЕНИЙ

### 7.1. FACT с нулем
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": [0],
    "id": 38
}

### 7.2. FACT с единицей
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": [1],
    "id": 39
}

### 7.3. DIV с очень маленькими числами
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "div",
    "params": [0.0001, 0.0001],
    "id": 40
}

### 7.4. SUM с отрицательными числами
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": [-5, -3],
    "id": 41
}

### 7.5. MUL с нулем
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "mul",
    "params": [5, 0],
    "id": 42
}

