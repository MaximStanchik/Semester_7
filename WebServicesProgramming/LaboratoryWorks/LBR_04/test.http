### Base URLs
@host = https://localhost:7063
@jsonrpc = /jsonrpc
@sse = /sse

### 1. SSE ПОДКЛЮЧЕНИЕ (запускать в отдельном окне/вкладке)

### 1.1. Подключиться к SSE серверу
GET {{host}}{{sse}}/subscribe
Accept: text/event-stream
Cache-Control: no-cache

### 2. ОДИНОЧНЫЕ ЗАПРОСЫ С SSE УВЕДОМЛЕНИЯМИ

### 2.1. SUM - сложение (позиционные параметры)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": [15, 25],
    "id": 1
}

### 2.2. SUM - сложение (именованные параметры)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": {"x": 8.5, "y": 3.2},
    "id": 2
}

### 2.3. SUB - вычитание
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sub",
    "params": [50, 17],
    "id": 3
}

### 2.4. MUL - умножение
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "mul",
    "params": [6, 7],
    "id": 4
}

### 2.5. DIV - деление (успешное)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "div",
    "params": [100, 4],
    "id": 5
}

### 2.6. DIV - деление на ноль (ошибка с SSE уведомлением)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "div",
    "params": [10, 0],
    "id": 6
}

### 2.7. FACT - факториал (успешный)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": [7],
    "id": 7
}

### 2.8. FACT - факториал отрицательного числа (ошибка с SSE)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": [-3],
    "id": 8
}

### 2.9. FACT - факториал большого числа (переполнение)
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": [50],
    "id": 9
}

### 3. ПАКЕТНЫЕ ЗАПРОСЫ С SSE УВЕДОМЛЕНИЯМИ

### 3.1. Пакетный запрос с разными операциями
POST {{host}}{{jsonrpc}}
Content-Type: application/json

[
    {
        "jsonrpc": "2.0",
        "method": "sum",
        "params": [2, 3],
        "id": 10
    },
    {
        "jsonrpc": "2.0",
        "method": "mul",
        "params": {"x": 4, "y": 5},
        "id": 11
    },
    {
        "jsonrpc": "2.0",
        "method": "fact",
        "params": [6],
        "id": 12
    },
    {
        "jsonrpc": "2.0",
        "method": "div",
        "params": [10, 0],
        "id": 13
    }
]

### 3.2. Большой пакетный запрос
POST {{host}}{{jsonrpc}}
Content-Type: application/json

[
    {
        "jsonrpc": "2.0",
        "method": "sum",
        "params": [1, 1],
        "id": 14
    },
    {
        "jsonrpc": "2.0",
        "method": "sub",
        "params": [5, 2],
        "id": 15
    },
    {
        "jsonrpc": "2.0",
        "method": "mul",
        "params": [3, 4],
        "id": 16
    },
    {
        "jsonrpc": "2.0",
        "method": "div",
        "params": [20, 5],
        "id": 17
    },
    {
        "jsonrpc": "2.0",
        "method": "fact",
        "params": [5],
        "id": 18
    }
]

### 4. ТЕСТЫ ВАЛИДАЦИИ С SSE УВЕДОМЛЕНИЯМИ

### 4.1. Неизвестный метод
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "unknown_method",
    "params": [1, 2],
    "id": 19
}

### 4.2. Неправильные параметры для SUM
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": [5],
    "id": 20
}

### 4.3. Неправильные параметры для FACT
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "fact",
    "params": [5, 10],
    "id": 21
}

### 4.4. Пустые параметры
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": [],
    "id": 22
}

### 4.5. Параметры null
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": null,
    "id": 23
}

### 4.6. Отсутствует метод
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "params": [1, 2],
    "id": 24
}

### 4.7. Неправильный тип параметров
POST {{host}}{{jsonrpc}}
Content-Type: application/json

{
    "jsonrpc": "2.0",
    "method": "sum",
    "params": ["text", 2],
    "id": 25
}

### 5. РАЗНЫЕ ФОРМАТЫ ПАРАМЕТРОВ

### 5.1. SUB с именованными параметрами
